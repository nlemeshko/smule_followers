# Пример файла .env для локальной разработки
# Скопируйте этот файл в .env и заполните ваши значения

# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
SMULE_ACCOUNT_IDS=96242367,3150102762

# ОПЦИОНАЛЬНЫЕ ПЕРЕМЕННЫЕ
CHECK_INTERVAL=300
# Минимальная пауза между запросами Smule, включая разные аккаунты (секунды)
SMULE_REQUEST_DELAY=3
# Пауза после блокировки: 900, 1800, затем 3600 секунд при повторных блокировках
SMULE_BLOCK_COOLDOWN=900
# Необязательный Cookie header Smule; храните только в .env / Kubernetes Secret
SMULE_COOKIE=
LOG_LEVEL=INFO
DATA_DIR=./data
TZ=Europe/Kyiv
